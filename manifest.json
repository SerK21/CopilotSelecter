{
  "manifest_version": 3,
  "name": "CopilotSelecter",
  "short_name": "CopilotSelecter",
  "version": "1.0.1",
  "minimum_chrome_version": "116",
  "description": "Copilot Premium のモデル / モードを毎回自動で選択します。",
  "icons": {
    "16": "icons/icon-16.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_title": "CopilotSelecter",
    "default_popup": "src/popup/popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "options_ui": {
    "page": "src/options/options.html",
    "open_in_tab": true
  },
  "background": {
    "service_worker": "src/background.js"
  },
  "permissions": ["storage"],
  "host_permissions": [
    "https://copilot.microsoft.com/*",
    "https://*.copilot.microsoft.com/*",
    "https://copilot.com/*",
    "https://www.copilot.com/*",
    "https://www.bing.com/chat/*",
    "https://m365.cloud.microsoft/*",
    "https://m365.cloud.microsoft.com/*",
    "https://copilot.cloud.microsoft/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://copilot.microsoft.com/*",
        "https://*.copilot.microsoft.com/*",
        "https://copilot.com/*",
        "https://www.copilot.com/*",
        "https://www.bing.com/chat/*",
        "https://m365.cloud.microsoft/*",
        "https://m365.cloud.microsoft.com/*",
        "https://copilot.cloud.microsoft/*"
      ],
      "js": ["src/content/shared-global.js", "src/content/injector.js"],
      "run_at": "document_start",
      "all_frames": true
    },
    {
      "matches": [
        "https://copilot.microsoft.com/*",
        "https://*.copilot.microsoft.com/*",
        "https://copilot.com/*",
        "https://www.copilot.com/*",
        "https://www.bing.com/chat/*",
        "https://m365.cloud.microsoft/*",
        "https://m365.cloud.microsoft.com/*",
        "https://copilot.cloud.microsoft/*"
      ],
      "js": [
        "src/content/shared-global.js",
        "src/content/dom.js",
        "src/content/applier.js"
      ],
      "run_at": "document_idle",
      "all_frames": true
    }
  ]
}
